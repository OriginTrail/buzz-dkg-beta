{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buzz DKG Beta",
  "version": "0.5.7-dkg-beta.3",
  "identifier": "io.origintrail.buzz.dkgbeta",
  "build": {
    "beforeBuildCommand": "pnpm build:dkg-beta"
  },
  "plugins": {
    "updater": {
      "endpoints": []
    },
    "deep-link": {
      "desktop": {
        "schemes": ["buzz-dkg-beta"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.dkg-beta.plist"
    }
  }
}
